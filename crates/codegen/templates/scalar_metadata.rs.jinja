impl ScalarMetadata {
    /// Flat (single-identifier) form of the canonical name, e.g.
    /// "Contact.Email" -> "Contact_Email". Used where dotted names are not
    /// valid identifiers (runtime schema payload keys, Arrow metadata).
    pub fn flat_name(&self) -> String {
        flat_scalar_name(self.canonical_name)
    }
}

/// Derive the flat scalar name from a canonical name ("A.B" -> "A_B").
/// Canonical segments are PascalCase and never contain underscores, so the
/// mapping is bijective.
pub fn flat_scalar_name(canonical_name: &str) -> String {
    canonical_name.replace('.', "_")
}

pub fn scalar_metadata_by_canonical_name(name: &str) -> Option<&'static ScalarMetadata> {
    SCALAR_METADATA
        .iter()
        .find(|scalar| scalar.canonical_name == name)
}
