#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ScalarMetadata {
    pub canonical_name: &'static str,
    pub primitive: &'static str,
    pub sql_type: &'static str,
    pub json_schema_type: Option<&'static str>,
    pub format: Option<&'static str>,
    pub max_length: Option<usize>,
    pub min_length: Option<usize>,
    pub pattern: Option<&'static str>,
    /// Comparability equivalence class, `None` when the scalar has none.
    /// Field equality is NOT the comparability relation: two `None`s compare
    /// equal, so a direct comparison answers `true` for every pair of unclassed
    /// scalars. The relation is `ScalarDef::comparable_with`.
    pub comparability_class: Option<&'static str>,
    pub is_sortable: bool,
}

