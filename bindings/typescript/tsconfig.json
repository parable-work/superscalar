{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "comment": "backend.node.ts is the ESM-only napi backend (uses import.meta + createRequire); it is built by tsconfig.esm.json, not this CJS pass.",
  "exclude": ["src/backend.node.ts"]
}
