# Rust build output (root workspace; examples/acme-scalars has its own).
/target
*.err

# Binding build output. The Go archive dir is ignored in go/, the
# wasm-pack bundles in crates/wasm.
node_modules/
dist/
.venv/
__pycache__/
.pytest_cache/
*.so
/bindings/typescript/native/
/bindings/typescript/wasm-node/
/bindings/typescript/wasm-bundler/
# Release packaging output of the npm package (assemble job of release.yml).
/bindings/typescript/npm/
/bindings/typescript/*.tgz
