# Single source of truth for the non-Rust toolchain pins. The Rust version
# lives in rust-toolchain.toml. Workflows load this file with
#   grep -E '^[A-Za-z_][A-Za-z0-9_]*=' tools.env >> "$GITHUB_ENV"
# so the versions live in exactly one place; bump them here, never inline in a
# workflow. KEY=VALUE, no quotes/spaces (GitHub Actions $GITHUB_ENV format).
WASM_PACK_VERSION=0.15.0
CBINDGEN_VERSION=0.29.2
GO_VERSION=1.26.4
NODE_VERSION=24
PYTHON_VERSION=3.12
# Release-only pins (release.yml). cargo-zigbuild bundles ziglang, so one pin
# covers the zig linker used for the linux musl staticlibs and the napi addons.
CARGO_ZIGBUILD_VERSION=0.23.4
MATURIN_VERSION=1.15.0
